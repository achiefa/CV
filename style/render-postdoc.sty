% ============================================================================
%  render-postdoc.sty -- how entries LOOK in the academic variant.
%  Full author lists, journal references, thesis titles, every talk.
% ============================================================================
\ProvidesPackage{style/render-postdoc}[2026/07/30 Academic renderer]

% \pubentry{tags}{title}{authors}{venue}{arxiv-id}
\renewcommand{\pubentry}[5]{%
  \item[] \textbf{#2}\\
  #3 \\
  #4\IfStrEq{#5}{}{}{ | e-Print: \arxiv{#5}}}

% \expentry{organisation}{role}{dates}{body}
\renewcommand{\expentry}[4]{%
  \item[] \headerrow{\textbf{#1} — #2}{#3}
  #4}

% \eduentry{degree}{grade}{dates}{institution+supervisor}{detail}
\renewcommand{\eduentry}[5]{%
  \item[] \headerrow{\textbf{#1}\IfStrEq{#2}{}{}{ (#2)}}{#3}
  #4 \\ #5}

% \talkentry{title}{url}{date}{event}
\renewcommand{\talkentry}[4]{%
  \item[] \headerrow{\href{#2}{\textbf{#1}}}{#3}
  #4}

% \awardentry{tags}{name+link}{dates}{description}
\renewcommand{\awardentry}[4]{%
  \item[] \headerrow{\textbf{#2}}{#3}
  #4}
\endinput
