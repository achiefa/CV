\newcommand{\headerrow}[2]{%
  \begin{tabular*}{\linewidth}{l@{\extracolsep{\fill}}r}#1 & #2 \\\end{tabular*}}
% Same, but ends the paragraph so body text that follows starts on a new line.
% Renderers should use this whenever a description follows the header.
\newcommand{\headerline}[2]{\headerrow{#1}{#2}\par\nobreak}

\pagestyle{empty}
\setlength{\tabcolsep}{0em}

% Loaded last by the variant file, after it has set fonts and geometry.
\newcommand{\cvloadhyperref}{%
  \RequirePackage{hyperref}%
  \hypersetup{linkcolor=blue, filecolor=magenta, urlcolor=cyan,
    pdfauthor={Amedeo Chiefa}, pdftitle={Amedeo Chiefa - Curriculum Vitae},
    pdfsubject={Work History and Experience of Amedeo Chiefa},
    pdfkeywords={CV, Résumé, Work History, Amedeo Chiefa}}}
