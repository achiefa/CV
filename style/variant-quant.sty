% ============================================================================
%  variant-quant.sty -- the INDUSTRY look, and the compact renderers.
%  Deliberately a different-looking document: sans-serif headings, a coloured
%  accent rule, tighter leading, no author lists, no thesis titles.
% ============================================================================
\ProvidesPackage{style/variant-quant}[2026/07/30 Industry variant]

\RequirePackage[a4paper,top=0.5in,bottom=0.5in,left=0.65in,right=0.65in]{geometry}
\RequirePackage{titlesec}

% ------------------------------------------------------------------ look --
\definecolor{cvaccent}{HTML}{1F3864} % dark blue

\titleformat
  {\subsection} % command
  [block] % shape
  {\normalsize\sffamily\bfseries\color{cvaccent}}   % format
  {}                                                          % Label
  {0em}                                                       % sep
  {}                                                          % before-code
  [\vspace{-0.6em}{\color{cvaccent}\rule{\linewidth}{1.2pt}}] % after-code

\titlespacing*{\subsection}%
  {0pt} % Increment left margin
  {0.75em} % vertical space before title
  {0.3em} % separation between title and non-sectioning text

\newcommand{\cvsection}[1]{\subsection*{#1}}

\setlist[itemize]{itemsep=0.20em, topsep=0.2em, parsep=0em}
\newenvironment{cvlist}{\begin{itemize}[leftmargin=0.9em]}{\end{itemize}}
\newenvironment{cvsub}{\begin{itemize}[leftmargin=1.1em,label=\textbullet,topsep=0.1em]}{\end{itemize}}

% ------------------------------------------------------------- renderers --
% Compact. Authors dropped; role leads the line; thesis detail suppressed.
% #5 (lead-author flag) is deliberately ignored: this variant prints no legend.
\renewcommand{\pubentry}[5]{%
  \item[] \textbf{#1} — #3\IfStrEq{#4}{}{}{ | \arxiv{#4}}}

\renewcommand{\expentry}[4]{%
  \item[] \headerline{\textbf{#2}, #1}{#3}#4}

% {degree}{grade}{dates}{institution}{supervisor}{detail}
% Grade is promoted to the date column; supervisor and thesis are dropped.
\renewcommand{\eduentry}[7]{%
  \item[] \headerrow{\textbf{#1}, #4}{\IfStrEq{#7}{}{#3}{#7}\IfStrEq{#2}{}{}{ — #2}}}

% As in the academic variant: linked title with the date aligned right, event
% beneath. Aligning the date on its own row keeps the column straight when a
% title or event wraps.
\renewcommand{\talkentry}[4]{%
  \item[] \headerline{\href{#2}{\textbf{#1}}}{#3}{\small #4}}

\renewcommand{\awardentry}[3]{\item[] \textbf{#1} (#2)}

\renewcommand{\skillentry}[2]{\item[] \textbf{#1:} #2}

\cvloadhyperref
\endinput
