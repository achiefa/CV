% ============================================================================
%  cvbase.sty -- shared machinery for every CV variant.
%  Contains NO content and NO variant-specific rendering.
% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style/cvbase}[2026/07/30 Shared CV base]

\RequirePackage[a4paper,margin=0.55in]{geometry}
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{titlesec}
\RequirePackage{etoolbox}
\RequirePackage{xstring}

% ---------------------------------------------------------------- variants --
% The driver calls \setcvvariant{postdoc} (or {quant}, ...) before \begin{document}.
\newcommand{\cvvariant}{none}
\newcommand{\setcvvariant}[1]{\renewcommand{\cvvariant}{#1}}

% \cvtext{variant}{content}  -- typeset content only in that variant.
\newcommand{\cvtext}[2]{\ifdefstring{\cvvariant}{#1}{#2}{}}
% \cvnot{variant}{content}   -- typeset content in every variant EXCEPT that one.
\newcommand{\cvnot}[2]{\ifdefstring{\cvvariant}{#1}{}{#2}}
% \cvhastag{taglist}{tag}{content} -- typeset content if tag appears in taglist.
\newcommand{\cvhastag}[3]{\IfSubStr{#1}{#2}{#3}{}}

% ----------------------------------------------------------------- helpers --
\newcommand{\me}{\textbf{A. Chiefa}}
\newcommand{\arxiv}[1]{\href{https://arxiv.org/abs/#1}{arXiv:#1}}
% Placeholder marker. Grep for \TODO before sending anything out.
\newcommand{\TODO}[1]{{\color{red}\textbf{[TODO: #1]}}}

\newcommand{\headerrow}[2]{%
  \begin{tabular*}{\linewidth}{l@{\extracolsep{\fill}}r}
    #1 & #2 \\
  \end{tabular*}}

% ------------------------------------------------------------------ layout --
\titleformat{\subsection}[block]{\large\bfseries}{}{0em}{}[\vspace{-0.55em}\rule{\linewidth}{0.6pt}]
\titlespacing*{\subsection}{0pt}{0.7em}{0.25em}
\newcommand{\cvsection}[1]{\subsection*{#1}}
\setlist[itemize]{itemsep=0.2em, topsep=0.25em, parsep=0em}
\newenvironment{cvlist}{\begin{itemize}[leftmargin=1em]}{\end{itemize}}
\newenvironment{cvsub}{\begin{itemize}[leftmargin=1.2em,label=--,topsep=0.15em]}{\end{itemize}}

\pagestyle{empty}
\setlength{\tabcolsep}{0em}

% ------------------------------------------------------------------ footer --
\newcommand{\cvfooter}{%
  \vfill\hrule
  \begin{description}\item
    \headerrow
      {{\textsubscript{Written in {\LaTeX} and generated using GitHub actions.}}}
      {{\textsubscript{@@version@@}}}
  \end{description}}

% ---------------------------------------------------- entry macro contract --
% Every render-*.sty MUST define these. Defaults error loudly so a missing
% definition fails the build instead of silently dropping content.
\newcommand{\pubentry}[5]{\PackageError{cvbase}{\string\pubentry\space undefined in this variant}{}}
\newcommand{\expentry}[4]{\PackageError{cvbase}{\string\expentry\space undefined in this variant}{}}
\newcommand{\eduentry}[5]{\PackageError{cvbase}{\string\eduentry\space undefined in this variant}{}}
\newcommand{\talkentry}[4]{\PackageError{cvbase}{\string\talkentry\space undefined in this variant}{}}
\newcommand{\awardentry}[4]{\PackageError{cvbase}{\string\awardentry\space undefined in this variant}{}}

\RequirePackage{hyperref}
\hypersetup{
  linkcolor=blue, filecolor=magenta, urlcolor=cyan,
  pdfauthor={Amedeo Chiefa},
  pdftitle={Amedeo Chiefa - Curriculum Vitae},
  pdfsubject={Work History and Experience of Amedeo Chiefa},
  pdfkeywords={CV, Résumé, Work History, Amedeo Chiefa},
}
\endinput
